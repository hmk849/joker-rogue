config_version=5

[application]
config/name="Joker Rogue"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.png"

[autoload]
SaveManager="*res://scripts/autoload/save_manager.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"
SafeAreaManager="*res://scripts/autoload/safe_area_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
AnimationManager="*res://scripts/autoload/animation_manager.gd"
CardManager="*res://scripts/autoload/card_manager.gd"
ConsumableManager="*res://scripts/autoload/consumable_manager.gd"
DeckManager="*res://scripts/autoload/deck_manager.gd"
ScoreManager="*res://scripts/autoload/score_manager.gd"
JokerManager="*res://scripts/autoload/joker_manager.gd"
BlindManager="*res://scripts/autoload/blind_manager.gd"
ShopManager="*res://scripts/autoload/shop_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
UIManager="*res://scripts/autoload/ui_manager.gd"

[display]
window/size/viewport_width=1334
window/size/viewport_height=750
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
